application-local.properties
application-local.yml
application-secret.properties
application-secret.yml


# ---------- IDE ----------
.idea/
.vscode/
*.iml

# Eclipse
.classpath
.project
.settings/


# ---------- Logs ----------
*.log
logs/


# ---------- OS ----------
.DS_Store
Thumbs.db


# ---------- Temporary files ----------
*.tmp
*.temp
*.swp
*.swo


# ---------- Environment / Secrets ----------
*.env
.env.*


# ---------- Build / Generated files ----------
out/
bin/